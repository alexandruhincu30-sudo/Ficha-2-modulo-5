tatic float media(const int valores[], int quantidade)
{
	int soma = 0;
	int i;

	for (i = 0; i < quantidade; i++)
		soma += valores[i];

	return (float)soma / quantidade;
}

static float mediana(int valores[], int quantidade)
{
	int i, j, aux;

	for (i = 0; i < quantidade - 1; i++)
	{
		for (j = i + 1; j < quantidade; j++)
		{
			if (valores[i] > valores[j])
			{
				aux = valores[i];
				valores[i] = valores[j];
				valores[j] = aux;
			}
		}
	}

	if (quantidade % 2 == 0)
		return (valores[quantidade / 2 - 1] + valores[quantidade / 2]) / 2.0f;

	return valores[quantidade / 2];
}
	
int EntreAB(int min, int max, int valor)
{
	if (valor >= min && valor <= max)
		return 1;

	return 0;
}
